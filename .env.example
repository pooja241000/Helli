# ==============================================================================
# ACCI ALERT - Production & Deployment Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Node.js / Express Server on Render, Railway, VPS)
# Never expose these in frontend code or Git repositories!
# ------------------------------------------------------------------------------

# Telegram Bot Token provided by @BotFather
TELEGRAM_BOT_TOKEN="8945333599:AAEGmRdt2rKdtA6I0lLJVlxM3bfyjSOwTpw"

# Emergency Contact Chat IDs (Designated next-of-kin / hospital responders)
TELEGRAM_CHAT_ID_1="8202503146"
TELEGRAM_CHAT_ID_2="7275581412"
TELEGRAM_CHAT_ID_3="8312506925"

# Shared secret key required in 'x-device-key' HTTP header for ESP32 hardware authentication
DEVICE_API_KEY="acci_sec_device_token_2026"

# Node.js Port and SQLite Database Storage Path
PORT=3000
DATABASE_PATH="./data/acci-alert.db"

# Heartbeat inactivity threshold before marking ESP32 "Disconnected" (default: 45s for 15s ESP32 cycle)
HEARTBEAT_TIMEOUT_SECONDS=45

# ------------------------------------------------------------------------------
# 2. FRONTEND CLIENT VARIABLES (Optional, for separate Vercel/Netlify hosting)
# Leave empty or omit if hosting frontend and backend on the same unified domain.
# If hosting frontend on Vercel/Netlify and backend on Render/Railway, specify the backend URL:
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=""
